{
    "name": "phunkie/phunkie",
    "description": "Functional structures library for PHP",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Marcello Duarte",
            "homepage": "http://marcelloduarte.net/"
        }
    ],
    "require": {
        "php": "8.2.* || 8.3.* || 8.4.* || 8.5.*"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "2.52.0",
        "friendsofphp/php-cs-fixer": "3.95.13",
        "giorgiosironi/eris": "1.1.0",
        "phpstan/phpstan": "2.2.5",
        "phpunit/phpunit": "11.5.56",
        "phunkie/phpstan": "1.0.0"
    },
    "autoload": {
        "psr-0": {
            "": [
                "src/"
            ]
        },
        "files": [
            "src/Phunkie/Functions/common.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "\\spec\\": [
                "spec/"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "bin-dir": "bin",
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "cs-fix": "bin/php-cs-fixer fix --config=.php-cs-fixer.php --diff --verbose --allow-risky=yes",
        "cs-check": "bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff --verbose --allow-risky=yes",
        "phpstan": "phpstan analyse --memory-limit=512M src",
        "lint": [
            "@cs-check",
            "@phpstan"
        ],
        "test": "bin/phpunit -c phpunit.xml.dist --do-not-cache-result",
        "test-debug": "bin/phpunit -c phpunit.xml.dist --debug",
        "test-all": "scripts/test-all-versions.sh",
        "check": [
            "@lint",
            "@test"
        ]
    }
}
